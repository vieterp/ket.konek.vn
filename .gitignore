# Neo về gốc: mẫu không có `/` đầu khớp thư mục CÙNG TÊN ở MỌI cấp, nên
# `scripts/` từng nuốt luôn `.github/scripts/` — nơi chứa script mà CI bắt buộc
# phải có. Ba thư mục dưới đây chỉ tồn tại ở gốc repo.
/scripts/
/plans/
/.claude/

# --- Server (Python) ---
server/.venv/
server/**/__pycache__/
server/**/*.py[cod]
server/.mypy_cache/
server/.ruff_cache/
server/.pytest_cache/
server/.coverage
server/htmlcov/
server/*.egg-info/

# --- Client (web UI + Tauri) ---
client/node_modules/
client/dist/
client/src-tauri/target/
client/src-tauri/gen/

# --- Bí mật: không bao giờ commit ---
# Khóa ký bản cập nhật Tauri, khóa mã hóa backup, creds DB đều nằm ở OS keystore
# hoặc biến môi trường (ADR-019) — file dưới đây chỉ là lưới an toàn.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# --- Hệ điều hành / IDE ---
.DS_Store
.idea/
.vscode/

# --- Rác công cụ (không thuộc sản phẩm) ---
.playwright-mcp/
ket-page*.yml
server/.claude/
docs/journals/

# --- Playwright (bộ đo hiệu năng lưới nhập liệu, spike S3) ---
client/test-results/
client/playwright-report/

# --- Tài liệu nguồn nội bộ: không phân phối, không track ---
# Bộ SRS, bản mirror MISA và Công báo TT99 là tài liệu nguồn để đối chiếu yêu cầu.
# Chúng nằm ngoài git theo quyết định của user (2026-09-01) — mã và kế hoạch trỏ
# vào chúng bằng đường dẫn, nên thư mục phải CÓ trên máy dev nhưng KHÔNG vào repo.
/docs/srs/
/docs/misa-kb/
/docs/TT99/
