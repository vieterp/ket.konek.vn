{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ket",
  "version": "0.7.0",
  "identifier": "vn.konek.ket",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Konek Két",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*:5443"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNzc2ODVCRDE3Mzk1MjIKUldRaWxYUFJXMmgzdTFkV01FOFI5UGxhTlhGaEhDNGdOdktHU3FYcW53b3U1OGRMaTB0SjFBZ20K",
      "endpoints": ["https://localhost:5443/updates/{{target}}/{{arch}}/{{current_version}}"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Konek",
    "category": "Business",
    "shortDescription": "Phần mềm kế toán doanh nghiệp Việt Nam",
    "longDescription": "Phần mềm kế toán theo TT200/TT133, chạy trong mạng LAN hoặc offline trên một máy."
  }
}
